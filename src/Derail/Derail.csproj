<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Require an explicit ConfigureAwait choice in library code. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA2007</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Lightweight functional primitives for C# 15 on .NET 11. Use Result for typed errors, Option for missing values, Validation for independent checks that collect errors, Reader for explicit dependencies, and Writer for ordered events.</Description>
  </PropertyGroup>

  <PropertyGroup Label="Packaging">
    <PackageId>Derail</PackageId>
    <Version>0.8.0</Version>
    <Authors>Fredrik Hagen Fasteraune</Authors>
    <PackageTags>result;option;maybe;either;validation;monad;railway;functional;union</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Frixxie/derail</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Frixxie/derail</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackDerailAnalyzer</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Derail.Analyzers/Derail.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Pack the analyzer from the path its project reference resolves to, not a hard-coded bin directory. -->
  <Target Name="PackDerailAnalyzer" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_DerailAnalyzer Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Derail.Analyzers'" />
      <TfmSpecificPackageFile Include="@(_DerailAnalyzer)" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
    <Error Condition="'@(_DerailAnalyzer)' == ''" Text="Derail.Analyzers.dll was not resolved, so the package would ship without DRL001." />
  </Target>
</Project>
